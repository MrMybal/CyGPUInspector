#include <winres.h>
#include <CyGPUInspectorCore/Version.hpp>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CYGI_VERSION_MAJOR,CYGI_VERSION_MINOR,CYGI_VERSION_PATCH,0
 PRODUCTVERSION CYGI_VERSION_MAJOR,CYGI_VERSION_MINOR,CYGI_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "CyGPUInspector"
            VALUE "FileDescription",  "CyGPUInspectorRS - ReShade capture agent for CyGPUInspector"
            VALUE "FileVersion",      CYGI_VERSION_STRING
            VALUE "InternalName",     "CyGPUInspectorRS"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Cyberalien - GNU AGPL v3 or later"
            VALUE "OriginalFilename", "CyGPUInspectorRS.addon64"
            VALUE "ProductName",      "CyGPUInspector"
            VALUE "ProductVersion",   CYGI_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
